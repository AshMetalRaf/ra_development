function collect_missions_data() => dword(0x7B8EC8)
function _0x3c() => dword((collect_missions_data() & 0x1FFFFFF) + 0x0000B0)

// $7B9A9F: [8-bit] Loading Active Flag
//          Note: bit flickery first centiseconds, in case this is used, use it with hits to avoid false resets
//          0x00 = False
//          0x01 = True
function loading_active_flag() => byte(0x7B9A9F)

// $7B9B58: [32-bit] Game State Flag
//          0x00 = Main Menu
//          0x01 = In-game
function game_state_flag() => dword(0x7B9B58)

// $7BB6C4: [32-bit Pointer] [32-bit Pointer] Heat Data
//          +0x3f8 |
//          .+0x48 |
//          ..+0x00 |
//          ...+0x138 | [32-bit] Police Heat Level
//          0x00-0x05 = Indicator

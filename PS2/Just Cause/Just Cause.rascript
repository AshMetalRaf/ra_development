//          0x00-0x05 = Indicator
function heat_data() => dword(0x7BB6C4)
function _0x48_2() => dword((heat_data() & 0x1FFFFFF) + 0x0003F8)

// $9AE58C: [32-bit] Player State 2/2
//          0x00 = During Cutscenes
//          0x01 = On Foot/Freefall/Parachute/Swimming
//          0x02 = Driving a Vehicle/Heli
//          0x05 = Using a Mounted Gun
//          0x06 = First person view
//          0x07 = During unskippable cutscenes (including mission failed scene)
function player_state_2_2() => dword(0x9AE58C)

// $9AE814: [32-bit] Last Driven Vehicle ID
//          Notes:
//          • Fallback address. Shared values won't be used in logic unless it's necessary, use with game state and mission ID.
//          • Although stored as a float, it's safer to document and handle it as 32-bit since the memory is constantly being overwritten and may yield inaccurate results when interpreted as a float.
//          
//          0x40c00000 = Default
//          ────────────── Motorcycle (7) ──────────────
//          0x402e58a9 = Fukuda Bluebolt (RARE)
//          0x4037e92e = Yamada 37-14 Vaquero
//          └────────> = Victory Bellevue
//          └────────> = Mosca 125 Rallye
//          └────────> = Apache Army Model 842
//          0x405ed46f = Fukuda Buckskin Trapper
//          0x4078f1ab = Rotor industries ATRV
//          ────────────── Car (29) ──────────────
//          0x40823b06 = Garret Paladin (RARE)
//          0x405dcfeb = Chevalier Supernova
//          0x40694426 = Cutler-Randall Arrowhead
//          0x406b7663 = Yamada Redwood SUV
//          0x406c1317 = Rossi 866 Corral
//          0x4072f484 = Vaultier Sedan Patrol Compact (RARE)
//          0x407d92a8 = Chevalier Street Bird De Luxe
//          0x407e0e6e = Taxi
//          0x40858795 = Huerta Mesa (shared with AVIA) (RARE)
//          0x408a096c = Scando 700 Sedan
//          0x40911b7f = EMVEE Armadillo (MV)
//          0x406b4a2f = Squire Synco (shared with Reichsmobil Transport)
//          0x406fd707 = Baxter Petit (shared with Reichsmobil Compact Mark II)
//          0x40704598 = Hurst Dagger (shared with Potomac Silverbullet)
//          0x40704598 = Potomac Silverbullet (shared with Hurst Dagger)
//          0x40744e2e = Fukuda Tournament (shared with GP Thunder Extreme Prototype)
//          0x407d7f6f = Wallys GP (shared with Meyer Compact T)
//          0x408c5840 = Cutler-Randall Conquistador (shared with Cutler Bullhorn)
//          0x4097bd1d = Fusilier Commander (shared with Jaeger SFJ 7, used in mission 8)
//          ────────────── Pickup (3) ──────────────
//          0x4067fa00 = Hurst Buckaroo
//          0x4087c3b6 = Shimizu Tumbleweed (shared with Stinger GP)
//          0x40744e2e = GP Thunder Extreme Prototype (shared with Fukuda Tournament)
//          ────────────── Bus (2) ──────────────
//          0x40d9720f = Pankhurst Bus Tap Tap
//          0x40efd707 = Vanderbildt Streamliner (shared with Battaille GPT-6)
//          ────────────── Van (5) ──────────────
//          0x40a0c9be = Vaultier ALEV Patrol Special (police heat level 4 and 5) (RARE)
//          0x406fd707 = Reichsmobil Compact Mark II (shared with Baxter Petit)
//          0x407d7f6f = Meyer Compact T (shared with Wallys GP)
//          0x408c5840 = Cutler Bullhorn (shared with Cutler-Randall Conquistador)
//          0x40a2f64b = MacNamara Emergency III (shared with Europ) (RARE)
//          ────────────── Tanks (2) ──────────────
//          0x40c31b46 = Ballard Centronel AAWV- 21
//          0x40d03e32 = Ballard Santry STRL - 14
//          ────────────── Truck (6) ──────────────
//          0x40bbf2d1 = Vanderbildt Route 66
//          0x40d0f114 = Meister ATV 4
//          0x40dd44e2 = The Vampire (used in mission 17) (RARE)
//          0x406b4a2f = Reichsmobil Transport (shared with Squire Synco)
//          0x40a2f64b = Europ (shared with MacNamara Emergency III)
//          0x40efd707 = Battaille GPT-6 (shared with Vanderbildt Streamliner, used in mission 5) (RARE)
//          ────────────── Helicopters (9) ──────────────
//          0x409af27d = Whiptail Gyrocopter
//          0x414aec8d = Jackson Z-19 Skreemer
//          0x414ce665 = HH-22 Savior
//          0x414ce665 = Mullen H45 Dragonfly
//          0x418a1006 = Delta MAH-15 Chimaera
//          0x418e9206 = Walker AH-16 Hammerbolt
//          0x41a9b4a4 = Jackson JC - 2 Alamo
//          0x411e6455 = Delta SH4 Boxhead (shared with Viper boatworks Seaserpent III)
//          0x412a1514 = Huerta PA51 Aztek (shared with Pequod - Harpoon PC 350)
//          ────────────── Planes (8) ──────────────
//          0x40bdf2f5 = McKenzie-Fergusson F2 Victor
//          0x4116f196 = Huerta SPA Ocelot
//          0x4124bae7 = Rage-Johnston F6 Comet
//          0x412d1104 = Walker PA Twin Fin
//          0x41366d96 = Rage-Johnston F10 Wraith
//          0x413a9728 = Ulysses-McCoy Redcloud
//          0x4187c3b6 = Stirling Jet Exclusive 9
//          0x421f4c68 = Alexander AX-14
//          ────────────── Boats (14) ──────────────
//          0x400f1bbd = Underwater Scooter (used only in mission 17) (RARE)
//          0x4097bd1d = Jaeger SFJ 7
//          0x40ad1104 = Bald Eagle - Parsuader
//          0x40cbb2d8 = Triereme - RC Athena
//          0x40e24630 = Trawler
//          0x412a1514 = Pequod - Harpoon PC 350
//          0x4178e6ce = Bosphorus boatworks - Patna exclusive
//          0x4118d6fc = Royal 500 - great white
//          0x403504f3 = Shimizu - Mach 2
//          0x4198d6fc = Triton Broadsider
//          0x40b504f3 = Triton - G3 Taiphoon (RARE)
//          0x410d88d2 = Triton - patroller
//          0x405700ee = Water Scooter (RARE)
//          0x411e6455 = Viper boatworks Seaserpent III (shared with Delta SH4 Boxhead)
//          ────────────── Other (4) ──────────────
//          0x40b31438 = Harland OTWV-2 Scout
//          0x40bb722d = Meister LAV 4
//          0x4087c3b6 = Stinger GP (shared with Shimizu Tumbleweed)
//          0x40858795 = AVIA (shared with Huerta Mesa) (RARE)
function last_driven_vehicle_id() => dword(0x9AE814)


// $7B5AA4: [32-bit] Gameplay Active Flag
//          0x00 = Inactive (Menus/Pause/Cutscenes/Hints)
//          0x01 = Active (Player Control)
function gameplay_active_flag() => dword(0x7B5AA4)

// $7B836C: [32-bit] Player State 1/2
//          0x00 = Alive
//          0x01 = Dead
function player_state_1_2() => dword(0x7B836C)

// $7B8928: [32-bit Pointer] Activity Data
//          Note: Active during events
//          ──────────── Mission 5 ────────────
//          +0x98 |
//          .+0x0c |
//          ..+0x108 |
//          ...+0x74 |
//          ....+0xc4 | [32-bit] Coca Crates Count
//          0x0e = Total amount in Truck
//          < 0x02 = Mission Failed (Must deliver at least 2 crates)
function activity_data() => dword(0x7B8928)
function _0x0c() => dword((activity_data() & 0x1FFFFFF) + 0x000098)

// $7B8A34: [32-bit Pointer] Race Data
//          Notes:
//          • Only active while in a race, otherwise it's 0x00.
//          • Once a race is finished, "your time" gets submitted into a dynamic address, see 0x7b8cdc
//          ───────────────────────────────────────────────────────────────────────────────────────────────
//          +0x14 |
//          .+0x60 | [32-bit float] Your Time (*100 decimal)
//          .+0x64 | [32-bit float] Time (*100 decimal)
//          .+0x80 | [8-bit] Race Active Flag
//          0x00 = False
//          0x01 = True
//          .+0xbc | [32-bit] Status (this stays active during the race and when the race finishes, 0x00 when timer runs out or when vehicle is deserted/destroyed)
//          .+0x120 | [32-bit float] Race finish counter
//          0x00 = Default
//          .+0x158 | [32-bit float] Time out counter
//          0x00 = Default
function race_data() => dword(0x7B8A34)
function _0x60_your_time() => dword((race_data() & 0x1FFFFFF) + 0x000014)

// $7B8E34: [32-bit Pointer] Player Data
//          +0x48 | [32-bit float] Health
//          0.0 = Dead
//          2000.0 = Max
//          500.0 <= Auto regen active (+5.0 per frame)
//          500.0 >= Regen inactive
//          ────────────────────── Equipment ──────────────────────
//          +0x24 |
//          .+0x1cc | [32-bit float] Grenade throw timer
//          0.0 = resets to this value every time you throw a greande
//          >5.000000 = explode target (value remains until another grenade is thrown)
//          ─────────────────────────────────────────
//          .+0x1fc | [16-bit] Grenade Status
//          0x0000 = Default
//          0x0001 = Thrown
//          0x0101 = Thrown and hit the ground
//          ─────────────────────────────────────────
//          +0xb0 |
//          .+0x08 | [32-bit] Reserved Ammo in Weapon A
//          .+0x0c | [32-bit] Reserved Ammo in Weapon B
//          .+0x24 | [32-bit] Reserved Ammo in Weapon C
//          .+0xc8 | [32-bit] Selected Weapon Slot
//          0x00 = Unarmed
//          0x02 = Holdt R4 Pitbulls
//          0x03 = Weapon A
//          0x04 = Weapon B
//          0x05 = Weapon C
//          0x06 = Protec Grappler G3
//          0x07 = Timed Explosives
//          0x08 = Triggered Explosives
//          0x09 = Remote Trigger
//          ─────────────────────────────────────────
//          +0x84 | [32-bit] Grenade Count
//          ─────────────────────────────────────────
//          +0xb8  |
//          .+0x48 |
//          ..+0x00 | [32-bit] Aim Active Flag
//          0x00 = False
//          0x01 = True
//          ────────────────────── Animation ──────────────────────
//          Note: Numbers indicate sequential stages of one continuous action.
//          +0x4f4 | [32-bit] Animations
//          ———— Basic Movement ————
//          0x00 = Idle Standing
//          0x01 = Idle Animation
//          0x02 = Walking
//          0x03 = Running
//          ———— Jump (Standing) ————
//          0x12 = 1/3 - Initiation
//          0x14 = 2/3 - Mid-air
//          0x16 = 3/3 - Landing
//          ———— Jump (Running) ————
//          0x13 = 1/3 - Initiation
//          0x15 = 2/3 - Mid-air
//          0x17 = 3/3 - Landing & Roll
//          ↕ OR
//          0x18 = 3/3 - Recovery
//          ———— Vehicle Interaction ————
//          0x1d = Enter Boat/Bus
//          ———— Enter Vehicle (Driver seat):
//          0x37 = 1/3 - Initiation
//          0x3d = 2/3 - Transition
//          0x38 = 3/3 - Seated
//          ———— Exit Vehicle (Driver seat):
//          0x39 = 1/2 - Initiation (Stationary)
//          0x3e = 2/2 - Complete (Stationary)
//          0x4e = 1/4 - Initation (Driving)
//          0x4f = 2/4 - Complete (Driving)
//          0x50 = 3/4 - Ragdoll (Driving)
//          0x32 = 4/4 - Standing Up
//          ———— Enter Vehicle (Passenger seat):
//          0x3a = 1/3 - Initiation
//          0x3f = 2/3 - Transition
//          0x3b = 3/3 - Seated
//          ———— Exit Vehicle (Passenger seat):
//          0x3c = 1/2 Initiation
//          0x40 = 2/2 Complete
//          0x41 = Seat Swap (Passenger to Driver)
//          0x43 = Driving
//          0x44 = Driving (Reversing)
//          ———— Stunt Positions (Out of Vehicle)
//          0x46 = 1/3 (Transition)
//          0x45 = 2/3 (Transition)
//          0x49 = 3/3 (Standing on car hood)
//          0x48 = Use Vehicle (From Stunt Position)
//          0x4a = Land on Vehicle
//          0x4b = Jump on Vehicle
//          0x4c = Open Parachute
//          ———— Air States
//          0x26 = Freefall
//          0x27 = Parachute Deploy 1/3 - Initiation
//          0x28 = Parachute Deploy 2/3 - Inflation
//          0x29 = Parachute Deploy 3/3 - Glide
//          0x2a = Parachute Release - Return to Freefall
//          ———— Swimming
//          0x60 = Surface Swim - Idle
//          0x63 = Surface Swim - Turn Left
//          0x64 = Surface Swim - Turn Right
//          0x65 = Surface Swim - Moving
//          0x66 = Dive
//          0x67 = Underwater - Idle
//          0x68 = Underwater - Moving
//          ———— Scenic
//          0x54 = End game cutscene
//          ─────────────────────────────────────────
//          +0x550 | [32-bit] Current Animation Performed
//          0x00 = Default
//          0x01 = Shooting
//          0x02 = Shooting
//          0x03 = Reloading
//          0x04 = Drawing a weapon
//          0x05 = ?????
//          0x06 = Punching
//          0x07 = Getting shot
//          0x08 = Throwing a grenade
//          0x09 = Holding onto a plane wing?
//          0x0a = Holding onto something
//          0x0b = Holding onto something
//          0x0c = T pose
//          0x0d = Holding onto something
//          ────────────────────── Location ──────────────────────
//          +0x818 |
//          .+0x50 |
//          ..+0x10 | [32-bit float] Player Position X
//          ..+0x14 | [32-bit float] Player Position Y
//          ..+0x18 | [32-bit float] Player Position Z
//          +0x818 |
//          .+0x58 |
//          ..+0xb0 | [32-bit float] Player Location X
//          ..+0xb4 | [32-bit float] Player Location Y
//          ..+0xb8 | [32-bit float] Player Location Z
//          ────────────────────────────────────────────
//          +0xbc |
//          .+0x310 |
//          ..+0x00 | [32-bit] vehicle related
function player_data() => dword(0x7B8E34)
function _0x1cc_grenade_throw_timer() => dword((player_data() & 0x1FFFFFF) + 0x000024)
function health() => float((player_data() & 0x1FFFFFF) + 0x000048)
function grenade_count() => dword((player_data() & 0x1FFFFFF) + 0x000084)
function _0x08_reserved_ammo_in_weapon_a() => dword((player_data() & 0x1FFFFFF) + 0x0000B0)
function _0x48() => dword((player_data() & 0x1FFFFFF) + 0x0000B8)
function animations() => dword((player_data() & 0x1FFFFFF) + 0x0004F4)
function current_animation_performed() => dword((player_data() & 0x1FFFFFF) + 0x000550)

// $7B8EC8: [32-bit Pointer] Collect Missions Data
//          Note: The "Collect Missions" stat (X/13) is not stored directly, it's calculated from the completion state of each individual collect mission.
//          
//          ──────────── 1. Salt Refinery... Yeah Right ────────────
//          +0xb0 |
//          .+0x3c |
//          ..+0x0c |
//          ...+0x318 |
//          ....+0x18 | [32-bit] Salt Refinery... Yeah Right: Collected Items
//          ....+0x1c | [32-bit] Salt Refinery... Yeah Right: Total (0x0a)
//          ....+0x20 | [8-bit] Salt Refinery... Yeah Right: Status
//          0x00 = Completed
//          0x01 = Incomplete
//          ──────────── 2. Back-Door Action ────────────
//          +0xb0 |
//          .+0x3c |
//          ..+0x0c |
//          ...+0x3d8 |
//          ....+0x18 | [32-bit] Back-Door Action: Collected Items
//          ....+0x1c | [32-bit] Back-Door Action: Total (0x05)
//          ....+0x20 | [8-bit] Back-Door Action: Status
//          0x00 = Completed
//          0x01 = Incomplete
//          ──────────── 3. I Want a Super-Potent Weapon ────────────
//          +0xb0 |
//          .+0x3c |
//          ..+0xc |
//          ...+0x28 |
//          ....+0x18 | [32-bit] I Want a Super-Potent Weapon: Collected Items
//          ....+0x1c | [32-bit] I Want a Super-Potent Weapon: Total (0x03)
//          ....+0x20 | [8-bit] I Want a Super-Potent Weapon: Status
//          0x00 = Completed
//          0x01 = Incomplete
//          ──────────── 4. I've Got the Blueprints, Man ────────────
//          +0xb0 |
//          .+0x3c |
//          ..+0x0c |
//          ...+0x00 |
//          ....+0x18 | [32-bit] I've Got the Blueprints, Man: Collected Items
//          ....+0x1c | [32-bit] I've Got the Blueprints, Man: Total (0x04)
//          ....+0x20 | [8-bit] I've Got the Blueprints, Man: Status
//          0x00 = Completed
//          0x01 = Incomplete
//          ──────────── 5. I Want My Intel Back ────────────
//          +0xb0 |
//          .+0x3c |
//          ..+0x0c |
//          ...+0x18 |
//          ....+0x18 | [32-bit] I Want My Intel Back: Collected Items
//          ....+0x1c | [32-bit] I Want My Intel Back: Total (0x0a)
//          ....+0x20 | [8-bit] I Want My Intel Back: Status
//          0x00 = Completed
//          0x01 = Incomplete
//          ──────────── 6. Red Eyes ────────────
//          +0xb0 |
//          .+0x3c |
//          ..+0x0c |
//          ...+0x08 |
//          ....+0x18 | [32-bit] Red Eyes: Collected Items
//          ....+0x1c | [32-bit] Red Eyes: Total (0x0a)
//          ....+0x20 | [8-bit] Red Eyes: Status
//          0x00 = Completed
//          0x01 = Incomplete
//          ──────────── 7. We Have Ways of Making You Talk ────────────
//          +0xb0 |
//          .+0x3c |
//          ..+0x0c |
//          ...+0x1e0 |
//          ....+0x18 | [32-bit] We Have Ways of Making You Talk: Collected Items
//          ....+0x1c | [32-bit] We Have Ways of Making You Talk: Total (0x05)
//          ....+0x20 | [8-bit] We Have Ways of Making You Talk: Status
//          0x00 = Completed
//          0x01 = Incomplete
//          ──────────── 8. Rico the Beachcomber ────────────

             _36_bytes_ascii_be_current_race_selected() == 0x57657374 && dword_be(0x5F5514) == 0x20536964 &&
             current_challenge_id() == 0x1BA && player_state_3() == 0x00 &&
             (prev(race_finished_flag()) == 0x00 && race_finished_flag() == 0x01),
    value  = measured(float(_0x24_time() + 0x24)),
    format = "SECS", lower_is_better = true
)

achievement(
    title = "Hold the Line", points = 10,
    description = "In a race of 2 or more laps with at least 3 opponents, take the lead and maintain 1st place until the end of the race on Hard difficulty",
    id = 559229, badge = "634957", published = "11/11/2025 4:34:21 PM", modified = "11/12/2025 11:36:56 AM",
    trigger = once(player_state_3() == 0x00 && car_slot_1() == 0xFFFFFFFF && game_state() == 0x01 &&
                  race_difficulty() == 0x02 && race_opponent_count() >= 0x03 && prev(race_checkpoints_reached()) == 0x00 &&
                  race_checkpoints_reached() == 0x01
              ) && once(prev(race_player_position()) != 0x01 && race_player_position() == 0x01) &&
              trigger_when((race_current_lap() >= 0x03 && prev(race_finished_flag()) == 0x00 && race_finished_flag() == 0x01)) &&
              disable_when(prev(race_player_position()) == 0x01 && race_player_position() > 0x01) &&
              unless(race_opponent_count() == 0x00) && unless(current_challenge_id() == 0x1B2) &&
              unless(current_challenge_id() == 0xFFFFFFFF) &&
              (always_false() || (never(player_state_3() == 0xFFFFFFFF)))
)


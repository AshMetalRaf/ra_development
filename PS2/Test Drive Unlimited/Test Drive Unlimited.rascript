//           Map: Kelekole Pass
//           0x02 = Not Visited
//           0x03 = Visited
function challenge_time_western_1_status() => dword(0x1ACD124)

// $1ACD128: [32-bit] Challenge: Race - Western 2 Status
//           Map: Wai'anae Kai
//           0x02 = Not Visited
//           0x03 = Visited
function challenge_race_western_2_status() => dword(0x1ACD128)

// $1ACD12C: [32-bit] Challenge: Race - Western Shore Status
//           Map: Wai'anae
//           0x02 = Not Visited
//           0x03 = Visited
function challenge_race_western_shore_status() => dword(0x1ACD12C)

// $1ACD130: [32-bit] Challenge: Time - Winding Wahiawa Status
//           Map: Kamananui
//           0x02 = Not Visited
//           0x03 = Visited
function challenge_time_winding_wahiawa_status() => dword(0x1ACD130)

// $1ACD134: [32-bit] Challenge: Time - Zig Zag Status
//           Map: Pa'a La'a Uka
//           0x02 = Not Visited
//           0x03 = Visited
function challenge_time_zig_zag_status() => dword(0x1ACD134)

// $1ACD20C: [32-bit] Player State
//           Note: It becomes 0x00 in garage, see 0x1abc7f4 for that.
//           0x00 = Not in a house
//           0x01b72004 = Inside a house
function player_state_6() => dword(0x1ACD20C)

// $1ACECB8: [2600 bytes array] Exploration struct. Tracks discovered roads.
//           0x00 = Not Discovered
//           0x01 = Discovered
//           0xffffffff = All Discovered (once king of the hill series challenge is completed)
function _2600_bytes_array_exploration_struct_tracks_discovered_roads() => word(0x1ACECB8)

// $1ACF716: [8-bit] Introduction Completed flag
//           0x00 = False
//           0x01 = True
function introduction_completed_flag() => byte(0x1ACF716)

// $1ACF720: [8-bit] King of the Hill Series Completed flag
//           Note: Unlocks all roads discovered. see 0x1acecb8
//           0x00 = False
//           0x01 = True
function king_of_the_hill_series_completed_flag() => byte(0x1ACF720)

// $1ACF722: [8-bit] Il Viaggio Grande Series Completed flag
//           Note: Unlocks all houses
//           0x00 = False
//           0x01 = True
function il_viaggio_grande_series_completed_flag() => byte(0x1ACF722)

// $1ACF764: [32-bit] Statistics: Number of Times Arrested
function statistics_number_of_times_arrested() => dword(0x1ACF764)

// $1ACF768: [32-bit] Statistics: Total Time 1/2
function statistics_total_time_1_2() => dword(0x1ACF768)

// $1ACF770: [32-bit] Statistics: Master Points 1/2
//           Format: Decimal
//           
//           Points   Level   | Prize
//           ─────────────────────────────────────────────────────────
//           0-99999 = Rookie
//           100000 = Amateur | Shelby GT500
//           250000 = Pro     | AC 427
//           500000 = Expert  | Shelby Cobra Daytona Coupe
//           1000000 = Master | Lamborghini Countach 25th Anniversary
function statistics_master_points_1_2() => dword(0x1ACF770)

// $1B70724: [32-bit Pointer] Car Data
//           +0x7c0 | [32-bit] Air time
//           0x00 = None
//           .+0x7c0 | [32-bit] Airtime active indicator
//           0x00 = Default
function car_data() => dword(0x1B70724)
function air_time() => dword((car_data() & 0x1FFFFFF) + 0x0007C0)

// $1B722D4: [32-bit] Player State
//           Note: Behaves similarily to other player status.
//           0x00 = Default
//           0x01b72340 = Inside Car Dealer, v-rent, paint shop
function player_state_7() => dword(0x1B722D4)

// $1B73298: [8 bytes] House Name (Only applicable inside Realtors)
//           0x00 = None (when outside the sell/exchange tab)
//           Note: When in the sell/exchange tab, this value shows the House ID. See address 0x1abc878 for reference.
function house_name() => dword(0x1B73298)

// $1B732A8: [24 bytes ASCII BE] Inside Realtor indicator string (Only applicable inside Realtors)
//           /ss_menu/array/houses = 0x2f73735f, 0x6d656e75, 0x2f617272, 0x61792f68, 0x6f757365, 0x73000000
function _24_bytes_ascii_be_inside_realtor_indicator_string() => dword_be(0x1B732A8)

// $1B73310: [32-bit] Number of Houses Owned (Only applicable inside Realtors)
function number_of_houses_owned() => dword(0x1B73310)

// $1B73984: [32-bit Pointer] Challenges Time
//           +0x6f4 |
//           .+0x24 | [32-bit float] Time
function challenges_time() => dword(0x1B73984)
function _0x24_time() => dword((challenges_time() & 0x1FFFFFF) + 0x0006F4)

// $1C94348: [32-bit] Viewing Houses inside Realtor Flag
//           0x00 = False
//           0x01 = True
function viewing_houses_inside_realtor_flag() => dword(0x1C94348)


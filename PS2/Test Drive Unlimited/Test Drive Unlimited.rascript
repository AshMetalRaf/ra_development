                  previous_location_visited() == 0xCF || previous_location_visited() == 0xD0 ||
                  previous_location_visited() == 0xD1 || current_challenge_id() == 0xFFFFFFFF)
              ) && disable_when(camera_view() != 0x03) && unless(race_opponent_count() == 0x00) &&

achievement(
    title = "Through the Driver's Eyes", points = 10,
    description = "Finish 1st in any race challenge of 3 or more laps with 3 or more opponents using only the cockpit camera view on Hard difficulty",
    id = 559228, badge = "634956", published = "11/11/2025 4:34:21 PM", modified = "11/14/2025 10:48:32 AM",
    trigger = trigger_when((player_state_3() == 0x00 && car_slot_1() == 0xFFFFFFFF && game_state() == 0x01 &&
                  race_difficulty() == 0x02 && race_player_position() == 0x01 && race_opponent_count() >= 0x03 &&
                  race_checkpoint_time() != 0x00 && race_current_lap() >= 0x04 && prev(race_finished_flag()) == 0x00 &&
                  race_finished_flag() == 0x01)
              ) &&
              unless((current_challenge_id() == 0x1B2 || previous_location_visited() == 0x24 ||
                  previous_location_visited() == 0x28 || previous_location_visited() == 0x30 ||
                  previous_location_visited() == 0x33 || previous_location_visited() == 0x44 ||
                  previous_location_visited() == 0x48 || previous_location_visited() == 0x49 ||
                  previous_location_visited() == 0x59 || previous_location_visited() == 0x5D ||
                  previous_location_visited() == 0x60 || previous_location_visited() == 0x61 ||
                  previous_location_visited() == 0x87 || previous_location_visited() == 0xA4 ||
                  previous_location_visited() == 0xBD || previous_location_visited() == 0xBE ||
                  previous_location_visited() == 0xBF || previous_location_visited() == 0xC0 ||
                  previous_location_visited() == 0xC1 || previous_location_visited() == 0xC2 ||
                  previous_location_visited() == 0xC3 || previous_location_visited() == 0xC4 ||
                  previous_location_visited() == 0xC5 || previous_location_visited() == 0xC6 ||

// Test Drive Unlimited
// #ID = 21154

// $5011A0: [32-bit] Current Car Driving
//          Note: Based on Car ID. Refer to 0x1abc828
//          0xffffffff = None / Indoor
function current_car_driving() => dword(0x5011A0)

// $503540: [32-bit] Race Difficulty
//          0x00 = Easy
//          0x01 = Normal
//          0x02 = Hard
function race_difficulty() => dword(0x503540)

// $56FAC4: [24 bytes ASCII BE] Global Serial
//          
//          ────── US Serial SLUS-21490 ──────
//          cdrom0:\SLUS_214.90;1 = 0x6364726f, 0x6d303a5c, 0x534c5553, 0x5f323134, 0x2e39303b, 0x31000000
//          
//          ────── EU Serial SLES-53753 ──────
//          cdrom0:\SLES_537.53;1 = 0x6364726f, 0x6d303a5c, 0x534c4553, 0x5f353337, 0x2e35333b, 0x31000000
function _24_bytes_ascii_be_global_serial() => dword_be(0x56FAC4)

// $582D10: [32-bit] Map Active Flag
//          0x00 = False
//          0x01 = True
function map_active_flag() => dword(0x582D10)

// $583040: [32-bit] Input
function input() => dword(0x583040)

// $5EAA00: [32-bit] Camera View
//          0x00 = Follow Near (default)
//          0x01 = Follow Far
//          0x02 = Bumper
//          0x03 = Cockpit
function camera_view() => dword(0x5EAA00)

// $5F1248: [32-bit] Game State
//          0x00 = Main Menu
//          0x01 = In-game
function game_state() => dword(0x5F1248)


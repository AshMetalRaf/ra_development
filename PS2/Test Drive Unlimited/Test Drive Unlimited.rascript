achievement(
    title = "King of the Island", points = 25,
    description = "Own all 56 houses on the island",
    id = 559253, badge = "634976", published = "11/11/2025 4:34:29 PM", modified = "11/11/2025 5:28:25 PM",
    trigger = ((statistics_total_time_1_2() != 0x00 && game_state() == 0x01 && dword_be(0x1B732AC) == 0x6D656E75 &&
                dword_be(0x1B732B0) == 0x2F617272 && dword_be(0x1B732B4) == 0x61795F68 &&
                dword_be(0x1B732B8) == 0x6F757365 &&
                measured(number_of_houses_owned() < 0x38, when=_24_bytes_ascii_be_inside_realtor_indicator_string() == 0x2F73735F) &&
                house_id_1() != 0x00 && house_id_2() != 0x00 && house_id_3() != 0x00 && house_id_4() != 0x00 &&
                (prev(house_id_410()) == 0x00 && house_id_410() != 0x00)) ||
               (car_slot_1() == 0xFFFFFFFF && game_state() == 0x01 && race_difficulty() != 0xFFFFFFFF &&
                race_player_position() == 0x01 &&
                (current_challenge_id() == 0xF0 || current_challenge_id() == 0x131 || current_challenge_id() == 0x145 ||
                    current_challenge_id() == 0x15A || current_challenge_id() == 0x15B || current_challenge_id() == 0x17A
                ) && prev(il_viaggio_grande_series_completed_flag()) == 0x00 &&
                il_viaggio_grande_series_completed_flag() == 0x01))
)

